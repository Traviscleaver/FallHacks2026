# Shared with live_recording.GeminiTranscriber. Add your key locally in .env.
GEMINI_KEY=
# Change if this generation model is unavailable to your project.
GEMINI_GENERATION_MODEL=gemini-2.5-flash
# Optional: chat uses GEMINI_GENERATION_MODEL when this is empty.
GEMINI_DEEP_DIVE_MODEL=
# Microphone transcription uses a separate Live model.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
# Optional device ID/name from: python test_program.py --list-devices
AUDIO_INPUT_DEVICE=
C_ANALYSIS_SECONDS=15
C_PROVISIONAL_SECONDS=90
C_BATCH_SEGMENTS=20
C_TEXT_BUDGET=24000
C_SLIDE_BATCH_PAGES=6
C_SLIDE_BATCH_BYTES=12000000
C_API_RETRIES=2
C_API_TIMEOUT_SECONDS=60
